# ── Say It Back API — environment variables ──────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=3000
NODE_ENV=production
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN=https://pleasehelpme.study,https://www.pleasehelpme.study

# --- Auth0 ---
# Auth0 Dashboard → Applications → APIs → your API
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.pleasehelpme.study

# --- Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- ElevenLabs (optional / stretch feature) ---
# Leave blank to disable voice — the app should work fine without it.
ELEVENLABS_API_KEY=
ELEVENLABS_ENABLED=false

# --- Database ---
# SQLite file path (created automatically on first run)
DB_PATH=./data/say-it-back.db
